{
  "manifestVersion": 5,
  "id": "com.codex.generative-fill",
  "name": "生成填充",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "generative-fill-panel",
      "label": "生成填充",
      "minimumSize": {
        "width": 280,
        "height": 420
      },
      "maximumSize": {
        "width": 360,
        "height": 1400
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 760
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "request"
  }
}
